# if you want to deploy on a specific network and not expose your api key
# you just create a .env.local (or .env.<network>.local) with the following
# ETH_NODE_URI_<network>=<endpoint-url>
# MNEMONIC_<network>="<mnemonic>>"
# you can also add the etherscan api key for verification
# ETHERSCAN_API_KEY=<api-key>

ETH_NODE_URI_localhost="http://127.0.0.1:8545"
MNEMONIC_localhost="test test test test test test test test test test test junk"

ETH_NODE_URI_lan="http://ethereum.local:8545"
MNEMONIC_lan="test test test test test test test test test test test junk"

# for faucet-server
FAUCET_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
# <amount-in-wei>:<rpc>
#
# ONE CLAIM IS ONE ONBOARDING. A new player's first transaction buys an avatar
# AND sends the local signer its stipend in the same call (the sale's
# `extraNativeTokenRecipient`), so a claim has to cover the price, the stipend
# and the gas for the purchase. This used to be 0.01, which is exactly the
# top-up ceiling, so the flow forwarded almost all of it to the signer and the
# purchase then found an empty wallet and asked for a SECOND claim.
#
# The stipend is 100 turns at the chain's worst gas price (see
# web/src/lib/world/config.ts), which is ~0.51 here. 1 native leaves room for
# the purchase gas and a second avatar.
CHAIN_31337=1000000000000000000:http://localhost:8545